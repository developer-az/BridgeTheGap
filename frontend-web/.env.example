# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is served. Used for invite links and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AI (schedule parsing, travel cost estimates). Leave blank for heuristics.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional: live travel data. Without these, fares are labelled "estimate".
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
COLLEGE_SCORECARD_API_KEY=
